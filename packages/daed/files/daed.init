#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/daed
CONF=/etc/daed/wing.db

start_service() {
    procd_open_instance
    procd_set_param command $PROG run --config $CONF
    # 正确的 respawn 参数：每小时最多重启10次，每次间隔5秒
    procd_set_param respawn 3600 5 10
    # 降低被 OOM Killer 杀死的概率
    procd_set_param oom_adj -16
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # 清理 eBPF 残留状态
    /usr/bin/daed-cleanup.sh 2>/dev/null || true
}
