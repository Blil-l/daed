#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/daed
CONF=/etc/daed/wing.db

start_service() {
    local enabled listen_addr log_maxbackups log_maxsize

    # 加载 UCI 配置
    config_load daed
    config_get_bool enabled 'config' 'enabled' 0
    config_get listen_addr 'config' 'listen_addr' '0.0.0.0:2023'
    config_get log_maxbackups 'config' 'log_maxbackups' '1'
    config_get log_maxsize 'config' 'log_maxsize' '5'

    # 如果 UCI 中未启用，则直接退出
    [ "$enabled" -eq 1 ] || {
        echo "daed is disabled in UCI config. Skip starting."
        return 0
    }

    procd_open_instance
    # 将 UCI 中的 listen_addr 传给 daed 启动命令
    # 注意：如果 daed 的 CLI 不支持 --listen 参数，请删除该参数，daed 会回退到 wing.db 中的默认配置
    procd_set_param command $PROG run --config $CONF --listen "$listen_addr"
    
    # 正确的 respawn 参数：每小时最多重启10次，每次间隔5秒
    procd_set_param respawn 3600 5 10
    
    # 降低被 OOM Killer 杀死的概率
    procd_set_param oom_adj -16
    
    # 将标准输出和错误输出重定向到系统日志，方便排查问题
    procd_set_param stdout 1
    procd_set_param stderr 1
    
    procd_close_instance
}

stop_service() {
    # 清理 daed 异常退出后残留的 eBPF 程序和网络命名空间
    # 这是防止路由器网络断网或失联的关键步骤！
    /usr/bin/daed-cleanup.sh 2>/dev/null || true
}
