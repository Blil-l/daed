#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/daed
CONF=/etc/daed/wing.db

# 加载清理脚本，使其函数可用
. /usr/bin/daed-cleanup.sh

start_service() {
    local enabled listen_addr

    config_load daed
    config_get_bool enabled 'config' 'enabled' 0
    config_get listen_addr 'config' 'listen_addr' '0.0.0.0:2023'

    [ "$enabled" -eq 1 ] || {
        echo "daed is disabled in UCI config. Skip starting."
        return 0
    }

    # 启动前清理残留状态（设置标记为 pre-start）
    DAED_GUARD_CLEANUP=start daed_cleanup_runtime

    procd_open_instance
    procd_set_param command $PROG run --config $CONF --listen "$listen_addr"
    procd_set_param respawn 3600 5 10
    procd_set_param oom_adj -16
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # 停止后清理残留状态（设置标记为 post-exit）
    DAED_GUARD_CLEANUP=stop daed_cleanup_runtime
}
